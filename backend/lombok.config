config.stopBubbling = true

# Lets Lombok's @RequiredArgsConstructor/@AllArgsConstructor propagate Spring's @Lazy from a field
# onto the generated constructor's parameter — needed to break the LeaveService -> ExceptionService
# -> AttendancePenaltyEvaluationService -> EmployeeService -> LeaveService construction-time cycle
# (EmployeeService has depended on LeaveService since before this change) without hand-writing a
# constructor just for that one field.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
